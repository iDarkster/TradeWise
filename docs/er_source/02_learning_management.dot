userId → id"];
"LessonProgress" -> "Lesson" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
lessonId → id"];
"QuizAttempt" -> "User" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
userId → id"];
"QuizAttempt" -> "Quiz" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
quizId → id"];
