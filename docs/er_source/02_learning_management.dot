(attemptId, quizId) → (id, quizId)"];
"UserAnswer" -> "Question" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
(questionId, quizId) → (id, quizId)"];
"UserAnswer" -> "Option" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
(selectedOptionId, questionId) → (id, questionId)"];
