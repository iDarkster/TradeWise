createdById → id"];
"Quiz" -> "User" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
updatedById → id"];
"Question" -> "Quiz" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
quizId → id"];
"Question" -> "MarketScenario" [dir=both, arrowtail=none, arrowhead=none, label="* : 0..1
scenarioId → id"];
"Option" -> "Question" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
questionId → id"];
