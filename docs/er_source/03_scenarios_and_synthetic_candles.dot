digraph ER {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.7", splines=polyline, fontname="Helvetica", label="3. Scenarios & synthetic candles", labelloc="t", fontsize=22];
node [shape=plain, fontname="Helvetica"];
edge [fontname="Helvetica", fontsize=8, color="#53657D", arrowsize=0.7];
"User" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA9BC"><TR><TD BGCOLOR="#172B4D" ALIGN="LEFT"><FONT COLOR="white"><B>User</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id: String [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">email: String [UQ]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">passwordHash: String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">role: UserRole</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">isActive: Boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">deletedAt: DateTime?</FONT></TD></TR></TABLE>>];
"MarketScenario" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA9BC"><TR><TD BGCOLOR="#172B4D" ALIGN="LEFT"><FONT COLOR="white"><B>MarketScenario</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id: String [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">createdById: String? [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">name: String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">description: String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">scenarioType: String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">difficulty: Difficulty</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">generationType: ScenarioGenerationType</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">createdAt: DateTime</FONT></TD></TR></TABLE>>];
"ScenarioCandle" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA9BC"><TR><TD BGCOLOR="#172B4D" ALIGN="LEFT"><FONT COLOR="white"><B>ScenarioCandle</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id: String [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">scenarioId: String [FK,UQ]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">sequenceIndex: Int [UQ]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">timestamp: DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">open: Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">high: Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">low: Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">close: Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">volume: BigInt</FONT></TD></TR></TABLE>>];
"Lesson" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA9BC"><TR><TD BGCOLOR="#172B4D" ALIGN="LEFT"><FONT COLOR="white"><B>Lesson</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id: String [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">moduleId: String [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">createdById: String [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">updatedById: String [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">title: String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">status: String</FONT></TD></TR></TABLE>>];
"LessonScenario" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA9BC"><TR><TD BGCOLOR="#172B4D" ALIGN="LEFT"><FONT COLOR="white"><B>LessonScenario</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">lessonId: String [PK,FK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">scenarioId: String [PK,FK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">displayOrder: Int?</FONT></TD></TR></TABLE>>];
"Question" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA9BC"><TR><TD BGCOLOR="#172B4D" ALIGN="LEFT"><FONT COLOR="white"><B>Question</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id: String [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">quizId: String [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">scenarioId: String? [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">questionText: String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">type: QuestionType</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">points: Int</FONT></TD></TR></TABLE>>];
"Lesson" -> "User" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
createdById → id"];
"Lesson" -> "User" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
updatedById → id"];
"Question" -> "MarketScenario" [dir=both, arrowtail=none, arrowhead=none, label="* : 0..1
scenarioId → id"];
"MarketScenario" -> "User" [dir=both, arrowtail=none, arrowhead=none, label="* : 0..1
createdById → id"];
"ScenarioCandle" -> "MarketScenario" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
scenarioId → id"];
"LessonScenario" -> "Lesson" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
lessonId → id"];
"LessonScenario" -> "MarketScenario" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
scenarioId → id"];
}