digraph ER {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.7", splines=polyline, fontname="Helvetica", label="5. Paper trading", labelloc="t", fontsize=22];
node [shape=plain, fontname="Helvetica"];
edge [fontname="Helvetica", fontsize=8, color="#53657D", arrowsize=0.7];
"User" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA9BC"><TR><TD BGCOLOR="#172B4D" ALIGN="LEFT"><FONT COLOR="white"><B>User</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id: String [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">email: String [UQ]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">passwordHash: String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">role: UserRole</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">isActive: Boolean</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">deletedAt: DateTime?</FONT></TD></TR></TABLE>>];
"Portfolio" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA9BC"><TR><TD BGCOLOR="#172B4D" ALIGN="LEFT"><FONT COLOR="white"><B>Portfolio</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id: String [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">userId: String [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">name: String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">initialBalance: Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">cashBalance: Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">createdAt: DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">updatedAt: DateTime</FONT></TD></TR></TABLE>>];
"Instrument" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA9BC"><TR><TD BGCOLOR="#172B4D" ALIGN="LEFT"><FONT COLOR="white"><B>Instrument</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id: String [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">symbol: String [UQ]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">exchange: String [UQ]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">providerInstrumentId: String?</FONT></TD></TR></TABLE>>];
"Order" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA9BC"><TR><TD BGCOLOR="#172B4D" ALIGN="LEFT"><FONT COLOR="white"><B>Order</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id: String [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">portfolioId: String [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">instrumentId: String [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">side: OrderSide</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">type: OrderType</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">status: OrderStatus</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">productType: ProductType</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">quantity: Int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">limitPrice: Decimal?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">createdAt: DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">updatedAt: DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">executedAt: DateTime?</FONT></TD></TR></TABLE>>];
"Trade" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA9BC"><TR><TD BGCOLOR="#172B4D" ALIGN="LEFT"><FONT COLOR="white"><B>Trade</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id: String [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">orderId: String [FK,UQ]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">executedQty: Int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">executedPrice: Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">totalValue: Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">executedAt: DateTime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">costBasisAmount: Decimal?</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">realizedPnl: Decimal?</FONT></TD></TR></TABLE>>];
"Holding" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA9BC"><TR><TD BGCOLOR="#172B4D" ALIGN="LEFT"><FONT COLOR="white"><B>Holding</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id: String [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">portfolioId: String [FK,UQ]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">instrumentId: String [FK,UQ]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">quantity: Int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">averageBuyPrice: Decimal</FONT></TD></TR></TABLE>>];
"PortfolioLedgerEntry" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#9AA9BC"><TR><TD BGCOLOR="#172B4D" ALIGN="LEFT"><FONT COLOR="white"><B>PortfolioLedgerEntry</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">id: String [PK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">portfolioId: String [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">tradeId: String? [FK]</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">entryType: String</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">amount: Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">balanceAfter: Decimal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">createdAt: DateTime</FONT></TD></TR></TABLE>>];
"Portfolio" -> "User" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
userId → id"];
"Order" -> "Portfolio" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
portfolioId → id"];
"Order" -> "Instrument" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
instrumentId → id"];
"Trade" -> "Order" [dir=both, arrowtail=none, arrowhead=none, label="0..1 : 1
orderId → id"];
"Holding" -> "Portfolio" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
portfolioId → id"];
"Holding" -> "Instrument" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
instrumentId → id"];
"PortfolioLedgerEntry" -> "Portfolio" [dir=both, arrowtail=none, arrowhead=none, label="* : 1
portfolioId → id"];
"PortfolioLedgerEntry" -> "Trade" [dir=both, arrowtail=none, arrowhead=none, label="* : 0..1
tradeId → id"];
}