# TradeWise — local environment template
#
# Copy to `.env` (development) and `.env.test` (integration tests) and fill in
# real values. Never commit either file.
#
# `.env.test` must point at a dedicated database whose name ends with `_test`.
# The backend refuses to start the test suite against any other database.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=tradewise
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=tradewise
DATABASE_URL=postgresql://tradewise:replace-with-a-local-password@127.0.0.1:5433/tradewise?schema=public

# --- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=5001

# --- Security secrets -------------------------------------------------------
# Each secret must be at least 32 characters. Generate them with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# SESSION_SECRET  keys the digest of the opaque session token.
# CSRF_SECRET    derives the session-bound CSRF token.
# RATE_LIMIT_SECRET  keys the HMAC digests of rate-limit identifiers.
SESSION_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# --- Cookies ----------------------------------------------------------------
# Cookie name used for the session cookie.
COOKIE_NAME=tw_session
# Leave unset to derive the value from NODE_ENV (secure in production).
# COOKIE_SECURE=true
# lax | strict | none ("none" requires COOKIE_SECURE=true).
COOKIE_SAME_SITE=lax
# Leave unset to keep the cookie host-only.
# COOKIE_DOMAIN=

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins. Required in production and
# must not contain "*". Coordinate the values with the frontend owner.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Trusted proxies --------------------------------------------------------
# Comma-separated IPs or CIDR ranges whose forwarded headers may be trusted.
# Leave empty when the backend is reached directly.
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
